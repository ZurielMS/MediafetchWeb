# Node Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Media Downloads (ignore video/audio files and dynamic metadata)
downloads/*
!downloads/.gitkeep

# Session Files (ignore Netscape cookies and private sessions)
session/*
!session/.gitkeep

# Runtime & Debug Logs
*.log
debug.log

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Environment configurations
.env
.env.local
.env.*.local

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor folders
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

