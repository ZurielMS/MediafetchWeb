# MediaFetch Environment Configuration

# Servidor
PORT=3000

# Cookies de YouTube (opcional, pero recomendado para servidores en la nube)
# Formato: archivo de cookies en formato Netscape
# YOUTUBE_COOKIES=archivo-cookies.txt

# Proxy personalizado (opcional, solo para servidores en la nube sin cookies)
# Ejemplo: http://proxy.datacenter.proxy:3128
# HTTP_PROXY=http://proxy.example.com:3128
